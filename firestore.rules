rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data, userId) {
      return data.id == userId
        && data.id is string
        && data.id.size() <= 128
        && data.email is string
        && data.email.size() <= 256
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024))
        && (!('createdAt' in data) || data.createdAt is string)
        && (!('lastLoginAt' in data) || data.lastLoginAt is string);
    }

    // Users Collection Rules
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUser(request.resource.data, userId);
      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUser(request.resource.data, userId)
        && request.resource.data.id == resource.data.id;
      allow delete: if false;
    }

    // Connection test document
    match /test/connection {
      allow get: if true;
    }
  }
}
